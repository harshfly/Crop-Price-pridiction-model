# ═══════════════════════════════════════════════════════════
# KrishiMitra AI — Environment Variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── Data Source API Keys ──────────────────────────────────
AGMARKNET_API_KEY=your_agmarknet_api_key_here
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
IMD_API_KEY=your_imd_api_key_here

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://krishimitra:password@localhost:5432/krishimitra_db

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Notification Services ────────────────────────────────
MSG91_API_KEY=your_msg91_api_key_here
MSG91_SENDER_ID=KRMTRA
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Redis (for Celery task queue) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application Config ───────────────────────────────────
APP_ENV=development
APP_PORT=8000
MODEL_DIR=models/saved
LOG_LEVEL=INFO
